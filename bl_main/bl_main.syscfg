 * @cliArgs --device "F2838x" --package "337bga" --part "F2838x_337bga" --context "CPU1" --product "C2000WARE@5.00.00.00"
 * @versions {"tool":"1.17.0+3128"}
 */

/**
 * Import the modules used in this configuration.
 */
const cputimer       = scripting.addModule("/driverlib/cputimer.js", {}, false);
const cputimer1      = cputimer.addInstance();
const device_support = scripting.addModule("/driverlib/device_support.js");
const gpio           = scripting.addModule("/driverlib/gpio.js", {}, false);
const gpio1          = gpio.addInstance();
const sci            = scripting.addModule("/driverlib/sci.js", {}, false);
const sci1           = sci.addInstance();
const spi            = scripting.addModule("/driverlib/spi.js", {}, false);
const spi1           = spi.addInstance();
const sysctl         = scripting.addModule("/driverlib/sysctl.js");

/**
 * Write custom configuration values to the imported modules.
 */
cputimer1.$name          = "BASE_1ms_TIMER";
cputimer1.timerPrescaler = 200;
cputimer1.timerPeriod    = 1000000;

device_support.useStandardCodeStartBranch = false;

gpio1.direction         = "GPIO_DIR_MODE_OUT";
gpio1.writeInitialValue = true;
gpio1.$name             = "SPI_STEn";
gpio1.gpioPin.$assign   = "GPIO125";

sci1.$name                 = "BL_SCI";
sci1.sci.$assign           = "SCIA";
sci1.sci.sci_rxPin.$assign = "GPIO43";
sci1.sci.sci_txPin.$assign = "GPIO42";

spi1.transferProtocol        = "SPI_PROT_POL0PHA1";
spi1.useInterrupts           = false;
spi1.useCase                 = "CUSTOM";
spi1.useInterfacePins        = ["SPI@_CLK","SPI@_SIMO","SPI@_SOMI"];
spi1.bitRate                 = 400000;
spi1.mode                    = "SPI_MODE_CONTROLLER";
spi1.emulationMode           = "SPI_EMULATION_STOP_AFTER_TRANSMIT";
spi1.$name                   = "DISPLAY_SPI";
spi1.spi.$assign             = "SPIC";
spi1.spi.spi_picoPin.$assign = "GPIO122";
spi1.spi.spi_pociPin.$assign = "GPIO123";
spi1.spi.spi_clkPin.$assign  = "GPIO124";

sysctl.enable_SYSCTL_PERIPH_CLK_CLA1      = false;
sysctl.enable_SYSCTL_PERIPH_CLK_DMA       = false;
sysctl.enable_SYSCTL_PERIPH_CLK_TIMER1    = false;
